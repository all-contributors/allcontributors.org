---
import type { AvatarKind } from "@/libs/illustrations";

import Avatar from "./Avatar.astro";
import Sparkle from "./Sparkle.astro";

const CELL = 150;

const before: AvatarKind[] = ["maintainer", "developer"];
const after: AvatarKind[] = ["maintainer", "developer", "designer"];

const topRow = before.map((kind, index) => ({ kind, x: 70 + index * CELL, y: 60 }));
const bottomRow = after.map((kind, index) => ({ kind, x: 70 + index * CELL, y: 360 }));
---

<svg
	class="illustration"
	viewBox="0 0 640 540"
	role="img"
	aria-label="A comment that mentions the All Contributors app adds a new person to a row of contributors."
	xmlns="http://www.w3.org/2000/svg"
>
	<defs>
		<marker
			id="how-it-works-arrow"
			viewBox="0 0 10 10"
			refX="7"
			refY="5"
			markerWidth="9"
			markerHeight="9"
			orient="auto"
		>
			<path class="arrow-head" d="M0 0L10 5L0 10Z"></path>
		</marker>
	</defs>

	<circle class="backdrop" cx="320" cy="270" r="262"></circle>

	{
		topRow.map(({ kind, x, y }) => (
			<g>
				<rect class="cell" x={x} y={y} width={CELL} height={CELL} />
				<g transform={`translate(${x + CELL / 2 - 40} ${y + 18}) scale(0.5)`}>
					<Avatar id={`flow-top-${kind}`} kind={kind} />
				</g>
				<rect class="bar" x={x + 32} y={y + 108} width="86" height="8" rx="4" />
				<rect class="bar" x={x + 47} y={y + 124} width="56" height="6" rx="3" opacity="0.6" />
			</g>
		))
	}
	<rect class="placeholder" x="370" y="60" width={CELL} height={CELL} rx="2"></rect>

	<path
		class="arrow"
		d="M530 132C628 160 632 322 482 352"
		marker-end="url(#how-it-works-arrow)"></path>

	<g transform="translate(46 238) scale(0.4)">
		<Avatar id="flow-commenter" kind="maintainer" />
	</g>
	<rect class="comment" x="124" y="238" width="404" height="64" rx="10"></rect>
	<text class="comment-text" x="142" y="276">
		<tspan class="mention">@all-contributors</tspan> please add @jane for docs
	</text>
	<rect class="app" x="528" y="238" width="68" height="64" rx="10"></rect>
	<g class="laurel">
		<path d="M546 288C534 274 534 256 544 246"></path>
		<path d="M578 288C590 274 590 256 580 246"></path>
	</g>
	<Sparkle x={562} y={268} size={13} />
	<Sparkle x={549} y={257} size={4} opacity={0.7} />
	<Sparkle x={575} y={279} size={4} opacity={0.7} />

	{
		bottomRow.map(({ kind, x, y }) => (
			<g>
				<rect class="cell" x={x} y={y} width={CELL} height={CELL} />
				<g transform={`translate(${x + CELL / 2 - 40} ${y + 18}) scale(0.5)`}>
					<Avatar id={`flow-bottom-${kind}`} kind={kind} />
				</g>
				<rect class="bar" x={x + 32} y={y + 108} width="86" height="8" rx="4" />
				<rect class="bar" x={x + 47} y={y + 124} width="56" height="6" rx="3" opacity="0.6" />
			</g>
		))
	}

	<Sparkle x={590} y={450} size={18} />
	<Sparkle x={614} y={424} size={8} opacity={0.7} />
	<Sparkle x={566} y={484} size={8} opacity={0.6} />
</svg>

<style>
	.illustration {
		width: 100%;
		height: auto;
		overflow: visible;
	}

	.backdrop {
		fill: var(--sl-color-gray-6);
		opacity: 0.55;
	}

	.cell {
		fill: var(--sl-color-gray-7, var(--sl-color-gray-6));
		stroke: var(--sl-color-gray-5);
		stroke-width: 1.5;
	}

	.bar {
		fill: var(--sl-color-gray-5);
	}

	.placeholder {
		fill: none;
		stroke: var(--sl-color-text-accent);
		stroke-width: 2.5;
		stroke-dasharray: 9 7;
	}

	.arrow {
		fill: none;
		stroke: var(--sl-color-text-accent);
		stroke-width: 2.5;
		stroke-dasharray: 9 7;
	}

	.arrow-head {
		fill: var(--sl-color-text-accent);
	}

	.comment {
		fill: var(--sl-color-accent);
	}

	.comment-text {
		fill: var(--sl-color-text-invert);
		font-family: var(--sl-font);
		font-size: 18px;
		font-weight: 500;
	}

	.mention {
		text-decoration: underline;
		font-weight: 700;
	}

	.app {
		fill: var(--sl-color-gray-7, var(--sl-color-gray-6));
		stroke: var(--sl-color-gray-5);
		stroke-width: 1.5;
	}

	.laurel path {
		fill: none;
		stroke: var(--sl-color-text-accent);
		stroke-linecap: round;
		stroke-width: 3;
		opacity: 0.45;
	}
</style>
